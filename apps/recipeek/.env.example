# Production values belong in Sites runtime settings, never the hosting manifest.
# For local Workers use an ignored .dev.vars file with the same keys.
RECIPEEK_AUTH_MODE=sites
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
# Enable only after SMTP delivery has been verified.
RECIPEEK_EMAIL_DELIVERY_READY=false
# Optional operator-verified migration binding; never fill from browser input.
# RECIPEEK_LEGACY_AUTH_ID=<verified-Supabase-user-UUID>
# RECIPEEK_LEGACY_PROFILE_ID=<existing-profile-ID>
